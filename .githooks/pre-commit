#!/bin/sh
# Path B: real, blocking git pre-commit secret scan (docs/backlog.md's cifix-council item;
# docs/decisions.md 2026-09-09/2026-09-14). Installed via `core.hooksPath` (see package.json's
# `prepare` script) rather than a copied `.git/hooks/pre-commit` shim, so it stays in sync with
# this file automatically -- no re-copy step to forget when this script changes.
#
# git invokes hooks with cwd already at the repo's own top level, so a plain relative path here
# resolves correctly regardless of where the commit was run from -- and it silently no-ops if
# `node` is not on the invoking shell's PATH (a possible concern for some GUI/IDE git clients).
#
# This is a defense-in-depth, LOCAL, pre-commit-only backstop -- not an unbypassable control.
# `git commit --no-verify` skips this (and any) git hook entirely, as does a commit made by a
# client with no hooks configured, or one made before `npm install`/`npm ci` has ever run.
# `.github/workflows/ci.yml`'s OSS-01 full-history secret scan (unaffected by any local bypass,
# and the only check a server-side merge ever runs) is the real backstop.
#
# MUST stay executable in the committed tree (mode 100755) -- git silently ignores a non-
# executable hook file (githooks(5)); see GitHub Issue #187 and
# pre-commit-scan.test.ts's own regression test for this.
exec node src/secret-scan/pre-commit-scan.ts
