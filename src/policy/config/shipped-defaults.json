{
  "version": "0.2.0-s308-baseline-and-protect",
  "rules": [
    {
      "id": "baseline-allow-class-read-only",
      "effect": "allow",
      "verbs": [
        "tool-class:read-only"
      ],
      "rationale": "AP-1 baseline (#308 story E): a classified read-only MCP tool is allowed. Marker-only on purpose: no target, so a shell redirect into mcp/ cannot match (loader check V4), and a shell verb token equal to the marker is unresolved (PT-1). The verb-only shell read allow rests on story E0 (#408): the shell normalizer resolves only the closed read-only set (ls, cat, head, tail, wc, grep) to a read, so the allow covers nothing else (shell verb resolution is tool-blind, PT-2)."
    },
    {
      "id": "protect-claude-agents",
      "effect": "deny",
      "verbs": [
        "write",
        "create",
        "modify",
        "delete",
        "move",
        "rename"
      ],
      "targets": [
        ".claude/agents",
        ".claude/agents/"
      ],
      "rationale": "AP-10 (#308 story F): a session may not write this path; it decides or wires the gate.",
      "mandatory": true
    },
