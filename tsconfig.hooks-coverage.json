{
  // QA-ONLY project (Issue #361). Used SOLELY by src/qa/hook-typecheck-coverage-check.ts (CI step
  // "QA-18") to measure real tsc diagnostics against every production hook. Since Issue #361 closed,
  // tsconfig.hooks.json (the real `npm run build`/`npm run typecheck` gate) lists the same 3 hooks,
  // so this file no longer carries any excepted debt; it stays as the instrument's own resolved
  // project so QA-18 can prove every hooks/*.mjs is covered and that a NEW hook is not silently
  // absent from every project.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": ["hooks/pretooluse-kernel-gate.mjs", "hooks/sessionstart-tool-enum.mjs", "hooks/userpromptsubmit-halt-relay.mjs"],
  "exclude": ["dist/**", "node_modules/**"]
}
